+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from collections.abc import Sequence
+from functools import wraps
+from threading import Lock, RLock
+from typing import Any
+
+from transformers import PreTrainedTokenizerFast
+
+from vllm.entrypoints.openai.chat_completion.protocol import (
+    ChatCompletionRequest,
+)
+from vllm.entrypoints.openai.engine.protocol import (
+    DeltaMessage,
+    DeltaToolCall,
+    DeltaFunctionCall,
+    ExtractedToolCallInformation,
+)
+from vllm.logger import init_logger
+from vllm.tokenizers import TokenizerLike
+from vllm.tool_parsers.abstract_tool_parser import ToolParser
+from vllm.tool_parsers.hermes_tool_parser import Hermes2ProToolParser
+from vllm.tool_parsers.qwen3coder_tool_parser import Qwen3CoderToolParser
+
+logger = init_logger(__name__)
+_PARSER_INIT_LOCK = Lock()
+_FAST_TOKENIZER_LOCK = RLock()
+_FAST_TOKENIZER_METHODS = (
+    "__call__",
+    "encode",
+    "decode",
+    "batch_decode",
+    "get_vocab",
+)
+
+
+def _serialize_fast_tokenizer_methods(tokenizer_cls: type[Any]) -> None:
+    """Serialize mutable Rust-tokenizer access without changing its output."""
+    for method_name in _FAST_TOKENIZER_METHODS:
+        original = getattr(tokenizer_cls, method_name)
+        if getattr(original, "_yulan_serialized", False):
+            continue
+
+        @wraps(original)
+        def locked_method(*args, _original=original, **kwargs):
+            with _FAST_TOKENIZER_LOCK:
+                return _original(*args, **kwargs)
+
+        locked_method._yulan_serialized = True
+        setattr(tokenizer_cls, method_name, locked_method)
+
+
+_serialize_fast_tokenizer_methods(PreTrainedTokenizerFast)
+
+
+class YulanToolParser(ToolParser):
+    """Parse both Qwen3-Coder XML-style and Hermes JSON-style tool calls."""
+
+    def __init__(self, tokenizer: TokenizerLike):
+        super().__init__(tokenizer)
+        self.qwen3_coder: Qwen3CoderToolParser | None = None
+        self.hermes: Hermes2ProToolParser | None = None
+        self._streaming_delegate: str | None = None
+        self._pending_stream_text = ""
+        self._delegate_text = ""
+        self._delegate_token_ids: list[int] = []
+
+        # Fast tokenizers reject simultaneous mutable configuration changes
+        # with ``RuntimeError: Already borrowed``. Both delegated parser
+        # constructors encode their marker tokens, so serialize construction
+        # while keeping request parsing itself fully concurrent.
+        with _PARSER_INIT_LOCK:
+            try:
+                self.qwen3_coder = Qwen3CoderToolParser(tokenizer)
+            except Exception:
+                logger.exception("Failed to initialize qwen3_coder tool parser.")
+
+            try:
+                self.hermes = Hermes2ProToolParser(tokenizer)
+            except Exception:
+                logger.exception("Failed to initialize hermes tool parser.")
+
+        if self.qwen3_coder is None and self.hermes is None:
+            raise RuntimeError(
+                "Yulan tool parser could not initialize either qwen3_coder "
+                "or hermes parser."
+            )
+
+        self.tool_call_start_token = "<tool_call>"
+        self.tool_call_end_token = "</tool_call>"
+        self.qwen_function_prefix = "<function="
+
+    def _sync_state_from(self, parser: ToolParser) -> None:
+        self.prev_tool_call_arr = parser.prev_tool_call_arr
+        self.current_tool_id = parser.current_tool_id
+        self.current_tool_name_sent = parser.current_tool_name_sent
+        self.streamed_args_for_tool = parser.streamed_args_for_tool
+
+    def _extract_with_qwen(
+        self, model_output: str, request: ChatCompletionRequest
+    ) -> ExtractedToolCallInformation | None:
+        if self.qwen3_coder is None:
+            return None
+
+        extracted = self.qwen3_coder.extract_tool_calls(model_output, request)
+        self._sync_state_from(self.qwen3_coder)
+        return extracted if extracted.tools_called else None
+
+    def _extract_with_hermes(
+        self, model_output: str, request: ChatCompletionRequest
+    ) -> ExtractedToolCallInformation | None:
+        if self.hermes is None:
+            return None
+
+        extracted = self.hermes.extract_tool_calls(model_output, request)
+        self._sync_state_from(self.hermes)
+        return extracted if extracted.tools_called else None
+
+    def _delegate_streaming(
+        self,
+        parser: ToolParser,
+        previous_text: str,
+        current_text: str,
+        delta_text: str,
+        previous_token_ids: Sequence[int],
+        current_token_ids: Sequence[int],
+        delta_token_ids: Sequence[int],
+        request: ChatCompletionRequest,
+    ) -> DeltaMessage | None:
+        delta = parser.extract_tool_calls_streaming(
+            previous_text=previous_text,
+            current_text=current_text,
+            delta_text=delta_text,
+            previous_token_ids=previous_token_ids,
+            current_token_ids=current_token_ids,
+            delta_token_ids=delta_token_ids,
+            request=request,
+        )
+        self._sync_state_from(parser)
+        return delta
+
+    def _choose_streaming_delegate(self, current_text: str) -> str | None:
+        last_tool_start = current_text.find(self.tool_call_start_token)
+        if last_tool_start < 0:
+            return None
+
+        tool_payload = current_text[
+            last_tool_start + len(self.tool_call_start_token) :
+        ].lstrip()
+
+        if tool_payload.startswith("<"):
+            return "qwen3_coder"
+        if tool_payload.startswith("{"):
+            return "hermes"
+        if self.qwen_function_prefix in tool_payload:
+            return "qwen3_coder"
+        return None
+
+    def adjust_request(self, request: ChatCompletionRequest) -> ChatCompletionRequest:
+        if self.hermes is not None:
+            request = self.hermes.adjust_request(request)
+        else:
+            request = super().adjust_request(request)
+
+        if request.tools and request.tool_choice != "none":
+            request.skip_special_tokens = False
+        return request
+
+    def extract_tool_calls(
+        self,
+        model_output: str,
+        request: ChatCompletionRequest,
+    ) -> ExtractedToolCallInformation:
+        if self.qwen_function_prefix in model_output:
+            extracted = self._extract_with_qwen(model_output, request)
+            if extracted is not None:
+                return extracted
+            extracted = self._extract_with_hermes(model_output, request)
+            if extracted is not None:
+                return extracted
+        else:
+            extracted = self._extract_with_hermes(model_output, request)
+            if extracted is not None:
+                return extracted
+            extracted = self._extract_with_qwen(model_output, request)
+            if extracted is not None:
+                return extracted
+
+        return ExtractedToolCallInformation(
+            tools_called=False, tool_calls=[], content=model_output
+        )
+
+    def extract_tool_calls_streaming(
+        self,
+        previous_text: str,
+        current_text: str,
+        delta_text: str,
+        previous_token_ids: Sequence[int],
+        current_token_ids: Sequence[int],
+        delta_token_ids: Sequence[int],
+        request: ChatCompletionRequest,
+    ) -> DeltaMessage | None:
+        if not previous_text:
+            self._streaming_delegate = None
+            self._pending_stream_text = ""
+            self._delegate_text = ""
+            self._delegate_token_ids = []
+            # Parser instances are normally per request; also support reuse.
+            if self.qwen3_coder is not None:
+                self.qwen3_coder._reset_streaming_state()
+            if self.hermes is not None:
+                self.hermes.current_tool_id = -1
+                self.hermes.current_tool_name_sent = False
+                self.hermes.prev_tool_call_arr = []
+                self.hermes.streamed_args_for_tool = []
+                self.hermes.buffered_delta_text = ""
+            self.prev_tool_call_arr = []
+            self.streamed_args_for_tool = []
+            self.current_tool_id = -1
+            self.current_tool_name_sent = False
+
+        self._pending_stream_text += delta_text
+        content = ""
+        if self._streaming_delegate is None:
+            pending = self._pending_stream_text
+            tool_start = pending.find(self.tool_call_start_token)
+            if tool_start < 0:
+                # Retain only a possible partial marker, never ordinary prose.
+                held = 0
+                for size in range(1, min(len(pending), len(self.tool_call_start_token) - 1) + 1):
+                    if pending.endswith(self.tool_call_start_token[:size]):
+                        held = size
+                if not delta_text:  # Flush a literal partial marker at EOS.
+                    held = 0
+                content = pending[:-held] if held else pending
+                self._pending_stream_text = pending[-held:] if held else ""
+                return DeltaMessage(content=content) if content else None
+
+            content = pending[:tool_start]
+            self._pending_stream_text = pending[tool_start:]
+            self._streaming_delegate = self._choose_streaming_delegate(
+                self._pending_stream_text
+            )
+            if self._streaming_delegate is None:
+                return DeltaMessage(content=content) if content else None
+
+        parser = (self.qwen3_coder if self._streaming_delegate == "qwen3_coder"
+                  else self.hermes)
+        if parser is None:
+            return DeltaMessage(content=content) if content else None
+
+        # Delegates are state machines, not arbitrary-chunk parsers. Replay
+        # withheld text from the opening marker and split speculative bursts
+        # into small textual events. Keep markers atomic (Hermes buffers them).
+        calls: dict[int, DeltaToolCall] = {}
+        pending = self._pending_stream_text
+        consumed = 0
+        markers = (self.tool_call_start_token, self.tool_call_end_token)
+        while consumed < len(pending):
+            remaining = pending[consumed:]
+            marker = next((m for m in markers if remaining.startswith(m)), None)
+            # Match the existing non-streaming tolerance for an omitted
+            # </function>. Insert the missing delimiter only in delegate text.
+            if (marker == self.tool_call_end_token
+                    and self._streaming_delegate == "qwen3_coder"
+                    and parser.in_function
+                    and parser.function_end_token not in
+                    self._delegate_text.rsplit(self.tool_call_start_token, 1)[-1]):
+                pending = pending[:consumed] + parser.function_end_token + "\n" + remaining
+                continue
+            if delta_text and marker is None and any(m.startswith(remaining) for m in markers):
+                break
+            piece = marker or remaining[0]
+            consumed += len(piece)
+            old_text = self._delegate_text
+            # Text drives both delegates; only markers need synthetic token IDs
+            # for their special-token transition checks.
+            ids = self.model_tokenizer.encode(piece, add_special_tokens=False) if marker else []
+            old_ids = list(self._delegate_token_ids)
+            self._delegate_text += piece
+            self._delegate_token_ids.extend(ids)
+            # Qwen deliberately drops inter-call whitespace. At the wrapper
+            # boundary it is ordinary content and must be preserved verbatim.
+            if (self._streaming_delegate == "qwen3_coder"
+                    and not parser.is_tool_call_started
+                    and parser.current_tool_index > 0 and marker is None):
+                content += piece
+                continue
+            delta = self._delegate_streaming(
+                parser, old_text, self._delegate_text, piece,
+                old_ids, self._delegate_token_ids, ids, request,
+            )
+            if delta is None:
+                continue
+            if delta.content:
+                content += delta.content
+            for call in delta.tool_calls or []:
+                if call.index not in calls:
+                    calls[call.index] = call.model_copy(deep=True)
+                    continue
+                merged = calls[call.index]
+                if call.id is not None:
+                    merged.id = call.id
+                if call.type is not None:
+                    merged.type = call.type
+                if call.function is not None:
+                    if merged.function is None:
+                        merged.function = DeltaFunctionCall()
+                    for field in ("name", "arguments"):
+                        value = getattr(call.function, field)
+                        if value is not None:
+                            setattr(merged.function, field,
+                                    (getattr(merged.function, field) or "") + value)
+        self._pending_stream_text = pending[consumed:]
+        if calls or content:
+            return DeltaMessage(content=content or None, tool_calls=list(calls.values()))
+        return None
